* {
  box-sizing: border-box;
}

:root {
  font-family: Inter, system-ui, sans-serif;
  background: #0f172a;
  color: #e2e8f0;
  line-height: 1.5;
  font-weight: 400;
}

body {
  margin: 0;
  min-height: 100vh;
  background: linear-gradient(180deg, #020817 0%, #111827 100%);
}

button,
textarea {
  font: inherit;
}

.app-shell {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
}

.panel {
  width: min(960px, 100%);
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 20px;
  box-shadow: 0 25px 60px rgba(15, 23, 42, 0.45);
  padding: 24px;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 20px;
}

.eyebrow {
  margin: 0;
  font-size: 12px;
  letter-spacing: 0.12em;
  color: #7dd3fc;
  text-transform: uppercase;
}

h1 {
  margin: 4px 0 0;
  font-size: clamp(2rem, 3vw, 2.5rem);
}

.status-badge {
  padding: 8px 12px;
  border-radius: 999px;
  color: #0f172a;
  font-weight: 700;
  font-size: 12px;
}

textarea {
  width: 100%;
  border-radius: 16px;
  border: 1px solid rgba(148, 163, 184, 0.25);
  background: rgba(15, 23, 42, 0.7);
  color: #f8fafc;
  padding: 16px;
  resize: vertical;
  min-height: 120px;
}

.actions {
  display: flex;
  gap: 12px;
  margin-top: 16px;
}

button {
  background: #2563eb;
  color: white;
  border: none;
  border-radius: 12px;
  padding: 12px 18px;
  font-weight: 700;
  cursor: pointer;
}

button.secondary {
  background: rgba(51, 65, 85, 0.7);
}

button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.chat-box {
  margin-top: 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-height: 320px;
  max-height: 500px;
  overflow: auto;
  padding-top: 8px;
}

.message {
  display: flex;
}

.message.user {
  justify-content: flex-end;
}

.message.assistant {
  justify-content: flex-start;
}

.bubble {
  max-width: 75%;
  padding: 12px 14px;
  border-radius: 16px;
  background: rgba(30, 41, 59, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
}

.message.user .bubble {
  background: rgba(37, 99, 235, 0.75);
}

small {
  display: block;
  opacity: 0.75;
  margin-top: 8px;
}

.empty-state {
  height: 100%;
  display: grid;
  place-items: center;
  color: rgba(148, 163, 184, 0.9);
}
